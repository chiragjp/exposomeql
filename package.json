{
  "name": "exposomeql",
  "version": "0.2.0",
  "description": "MCP server for exposome research — 46 tools for querying 66.8M exposure-phenotype associations, NHANES survey data, CTD toxicogenomics, HHEAR cohort biomonitoring, and nutrient RCT evidence via natural language",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "exposomeql": "./bin/exposomeql.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chiragjp/exposomeql"
  },
  "homepage": "https://github.com/chiragjp/exposomeql#readme",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index-http.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/smoke-test.ts",
    "test:validate": "tsx scripts/validation-run.ts",
    "test:ci": "tsc --noEmit",
    "setup-r": "Rscript scripts/install-r-deps.R",
    "setup-py": "pip install pandas numpy scipy statsmodels",
    "convert-data": "tsx scripts/convert-to-parquet.ts",
    "ctd-etl": "tsx scripts/ctd-etl.ts",
    "eval:run": "tsx eval/run.ts",
    "eval:score": "tsx eval/score.ts",
    "eval:report": "tsx eval/report.ts"
  },
  "keywords": [
    "mcp",
    "nhanes",
    "exposome",
    "epwas",
    "epidemiology"
  ],
  "author": "Chirag J. Patel",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "duckdb": "^1.2.0",
    "fuse.js": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^1.50.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "js-yaml": "^4.1.1",
    "openai": "^6.34.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "bin/",
    "src/r-bridge/r-scripts/",
    "src/data/cohort-metadata.json",
    "src/data/epi-column-map.json",
    "data/nutrient_rct_evidence.csv",
    "data/nutrient_outcome_phenotype_map.csv",
    "scripts/setup-local-data.sh",
    "scripts/ctd-etl.ts",
    "scripts/install-r-deps.R",
    "README.md"
  ]
}
