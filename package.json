{
  "name": "exposomeql",
  "version": "0.1.0",
  "description": "MCP server for exposome research — query NHANES data and EP-WAS associations via natural language",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "exposomeql": "./bin/exposomeql.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "convert-data": "tsx scripts/convert-to-parquet.ts"
  },
  "keywords": ["mcp", "nhanes", "exposome", "epwas", "epidemiology"],
  "author": "Chirag J. Patel",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "duckdb": "^1.2.0",
    "fuse.js": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "bin/",
    "src/r-bridge/r-scripts/"
  ]
}
